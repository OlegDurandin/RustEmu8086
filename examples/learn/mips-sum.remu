  "exercise": {
    "version": 1,
    "id": "mips-sum",
    "title": "MIPS Sum two integers",
    "description": "Level: beginner. Read two integers using syscall 5. Store their 32-bit sum in $t0 using unsigned addition; overflow wraps. Exit with syscall 10. Checks cover $t0 and exit status.",
    "architecture": "MIPS32",
    "starter_code": ".text\nmain:\n# TODO: read two integers, calculate $t0\nli $v0,10\nsyscall\n",
    "step_limit": 10000,
    "time_limit_ms": 1000,
    "hint": "Save the first value before reading again. Use ADDU for wrapping addition.",
    "cases": [
      {
        "name": "positive",
        "input": "3\n4\n",
        "initial_registers": {},
        "expected": {
          "output": null,
          "registers": {
            "$t0": 7
          },
          "memory": [],
          "termination": {
            "Exited": 0
          }
        }
      },
      {
