    "version": 1,
    "id": "8086-array-store",
    "title": "8086 Store a word in memory",
    "description": "Level: beginner. Store AX into slot. Preserve AX and guard bytes. DS=0700h, slot at 0200h. Check the word and both guard bytes.",
    "architecture": "8086",
    "starter_code": "org 100h\n; TODO: store AX into slot\nhlt\norg 01ffh\ndb 55h\nslot dw 0\ndb 0aah\n",
    "step_limit": 10000,
    "time_limit_ms": 1000,
    "hint": "Inspect DS:0200 and its neighbours. A word is little endian; writing two bytes must not change the guard bytes.",
