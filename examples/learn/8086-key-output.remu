    "version": 1,
    "id": "8086-key-output",
    "title": "8086 Keyboard and DOS output",
    "description": "Level: beginner. Read one key using INT 16h. Copy its ASCII to BL and print once using DOS AH=2. End with HLT. Input is provided by each case.",
    "architecture": "8086",
    "starter_code": "org 100h\n; TODO: implement the goal\nhlt\n",
    "step_limit": 10000,
    "time_limit_ms": 1000,
    "hint": "INT 16h AH=0 returns ASCII in AL. DOS AH=2 prints DL. Inspect BL before changing AH.",
    "cases": [
      {
        "name": "A",
        "input": "A",
        "initial_registers": {},
        "expected": {
          "output": "A",
          "registers": {
