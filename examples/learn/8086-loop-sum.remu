    "version": 1,
    "id": "8086-loop-sum",
    "title": "8086 LOOP triangular sum",
    "description": "Level: beginner. Sum 1 through initial CX into AX; support CX=0 without wrapping the loop. Leave CX=0. Finish HLT.",
    "architecture": "8086",
    "starter_code": "org 100h\n; TODO: implement the goal\nhlt\n",
    "step_limit": 10000,
    "time_limit_ms": 1000,
    "hint": "LOOP decrements CX. Starting with zero wraps to FFFF without a guard. Inspect CX and AX at the branch.",
